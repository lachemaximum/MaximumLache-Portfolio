# .env.example を .env にコピーして値を入れる。.env は Git に入れない。

# 楽天ウェブサービス（https://webservice.rakuten.co.jp/ でアプリ登録）
RAKUTEN_APP_ID=
# 楽天アフィリエイトID（これがあると affiliateUrl が返る）
RAKUTEN_AFFILIATE_ID=

# はてなブログ（設定 → 詳細設定 → AtomPub に表示される値）
HATENA_ID=
# ブログID（例: example.hatenablog.com）
HATENA_BLOG_ID=
HATENA_API_KEY=
